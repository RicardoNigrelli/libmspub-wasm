+
 void MSPUBCollector::setShapeBeginArrow(unsigned seqNum,
                                         const Arrow &arrow)
 {
@@ -676,7 +681,10 @@ void MSPUBCollector::setupShapeStructures(ShapeGroupElement &elt)
         rot = ptr_info->m_innerRotation.get();
       if (index - 1 < m_images.size())
