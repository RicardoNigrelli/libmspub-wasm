From: OpenImprenta <noreply@openimprenta.invalid>
Subject: [PATCH] Read the picture crop (Escher cropFromTop/Bottom/Left/Right)

Publisher stores the crop of a picture in the shape's FOPT record, next to
the picture id (pib), as the MS-ODRAW Blip properties cropFromTop (0x0100),
cropFromBottom (0x0101), cropFromLeft (0x0102) and cropFromRight (0x0103):
signed 16.16 fixed point fractions of the picture. libmspub did not read
them, so a cropped picture was imported whole, stretched into the visible
frame.

The values are now kept in ShapeInfo and passed on with the bitmap fill
(ImgFill::getProperties), as four non-ODF properties in RVNG_GENERIC units:

  libmspub:crop-from-top     fraction of the picture height hidden at the top
  libmspub:crop-from-bottom  fraction of the picture height hidden at the bottom
  libmspub:crop-from-left    fraction of the picture width hidden at the left
  libmspub:crop-from-right   fraction of the picture width hidden at the right

They are emitted only when at least one of them is non-zero, with the value
as stored (negative values, which MS-ODRAW allows, mean padding). Only the
Escher path (Publisher 2002 and later) is covered; MSPUBParser2k is unchanged.

diff --git a/src/lib/EscherFieldIds.h b/src/lib/EscherFieldIds.h
index 6245ea4..7d4542c 100644
--- a/src/lib/EscherFieldIds.h
+++ b/src/lib/EscherFieldIds.h
@@ -74,6 +74,10 @@
 #define FIELDID_END_ARROW_STYLE        0x01D1
 #define FIELDID_END_ARROW_WIDTH        0x01D4
 #define FIELDID_END_ARROW_HEIGHT       0x01D5
+#define FIELDID_CROP_FROM_TOP          0x0100
+#define FIELDID_CROP_FROM_BOTTOM       0x0101
+#define FIELDID_CROP_FROM_LEFT         0x0102
+#define FIELDID_CROP_FROM_RIGHT        0x0103
 #define FIELDID_PICTURE_CONTRAST       0x0108
 #define FIELDID_PICTURE_BRIGHTNESS     0x0109
 #define FIELDID_PICTURE_RECOLOR        0x011A
diff --git a/src/lib/Fill.cpp b/src/lib/Fill.cpp
index ccb3d42..759268e 100644
--- a/src/lib/Fill.cpp
+++ b/src/lib/Fill.cpp
@@ -22,10 +22,16 @@ Fill::Fill(const MSPUBCollector *owner) : m_owner(owner)
 {
 }
 
-ImgFill::ImgFill(unsigned imgIndex, const MSPUBCollector *owner, bool isTexture, int rot) : Fill(owner), m_imgIndex(imgIndex), m_isTexture(isTexture), m_rotation(rot)
+ImgFill::ImgFill(unsigned imgIndex, const MSPUBCollector *owner, bool isTexture, int rot) : Fill(owner), m_imgIndex(imgIndex), m_isTexture(isTexture), m_rotation(rot), m_hasCrop(false), m_crop(0, 0, 0, 0)
 {
 }
 
+void ImgFill::setCrop(const PictureCrop &crop)
+{
+  m_hasCrop = true;
+  m_crop = crop;
+}
+
 void ImgFill::getProperties(librevenge::RVNGPropertyList *out) const
 {
   out->insert("draw:fill", "bitmap");
@@ -45,6 +51,15 @@ void ImgFill::getProperties(librevenge::RVNGPropertyList *out) const
       sValue.sprintf("%d", m_rotation);
       out->insert("librevenge:rotate", sValue);
     }
+    if (m_hasCrop)
+    {
+      // Not ODF: there is no standard property for this. Fractions of the
+      // picture (1.0 = whole picture) hidden on each side, as in MS-ODRAW.
+      out->insert("libmspub:crop-from-top", m_crop.m_top / 65536.0, librevenge::RVNG_GENERIC);
+      out->insert("libmspub:crop-from-bottom", m_crop.m_bottom / 65536.0, librevenge::RVNG_GENERIC);
+      out->insert("libmspub:crop-from-left", m_crop.m_left / 65536.0, librevenge::RVNG_GENERIC);
+      out->insert("libmspub:crop-from-right", m_crop.m_right / 65536.0, librevenge::RVNG_GENERIC);
+    }
   }
 }
 
diff --git a/src/lib/Fill.h b/src/lib/Fill.h
index 39c5cab..0019f8e 100644
--- a/src/lib/Fill.h
+++ b/src/lib/Fill.h
@@ -19,6 +19,19 @@
 namespace libmspub
 {
 class MSPUBCollector;
+
+// Picture crop (MS-ODRAW cropFromTop/Bottom/Left/Right): signed 16.16 fixed
+// point fractions of the picture, positive = cropped, negative = padding.
+struct PictureCrop
+{
+  int m_top;
+  int m_bottom;
+  int m_left;
+  int m_right;
+  PictureCrop(int top, int bottom, int left, int right)
+    : m_top(top), m_bottom(bottom), m_left(left), m_right(right) { }
+};
+
 class Fill
 {
 protected:
@@ -40,11 +53,15 @@ private:
   bool m_isTexture;
 protected:
   int m_rotation;
+private:
+  bool m_hasCrop;
+  PictureCrop m_crop;
 public:
   ImgFill(unsigned imgIndex, const MSPUBCollector *owner, bool isTexture, int rotation);
+  void setCrop(const PictureCrop &crop);
   void getProperties(librevenge::RVNGPropertyList *out) const override;
 private:
-  ImgFill(const ImgFill &) : Fill(nullptr), m_imgIndex(0), m_isTexture(false), m_rotation(0) { }
+  ImgFill(const ImgFill &) : Fill(nullptr), m_imgIndex(0), m_isTexture(false), m_rotation(0), m_hasCrop(false), m_crop(0, 0, 0, 0) { }
   ImgFill &operator=(const ImgFill &);
 };
 
