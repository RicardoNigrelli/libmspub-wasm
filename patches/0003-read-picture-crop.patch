diff --git a/src/lib/MSPUBParser.cpp b/src/lib/MSPUBParser.cpp
index a3ea63a..2e7da30 100644
--- a/src/lib/MSPUBParser.cpp
+++ b/src/lib/MSPUBParser.cpp
@@ -1720,6 +1720,21 @@ void MSPUBParser::parseEscherShape(librevenge::RVNGInputStream *input, const Esc
             {
               m_collector->setShapePictureContrast(*shapeSeqNum, (int)(*ptr_pictureContrast));
             }
+            // MS-ODRAW Blip properties cropFromTop/Bottom/Left/Right: signed 16.16
+            // fixed point fractions of the picture, default 0 (no crop).
+            const unsigned *ptr_cropTop = getIfExists(foptValues.m_scalarValues, FIELDID_CROP_FROM_TOP);
+            const unsigned *ptr_cropBottom = getIfExists(foptValues.m_scalarValues, FIELDID_CROP_FROM_BOTTOM);
+            const unsigned *ptr_cropLeft = getIfExists(foptValues.m_scalarValues, FIELDID_CROP_FROM_LEFT);
+            const unsigned *ptr_cropRight = getIfExists(foptValues.m_scalarValues, FIELDID_CROP_FROM_RIGHT);
+            if ((ptr_cropTop && *ptr_cropTop) || (ptr_cropBottom && *ptr_cropBottom) ||
+                (ptr_cropLeft && *ptr_cropLeft) || (ptr_cropRight && *ptr_cropRight))
+            {
+              m_collector->setShapePictureCrop(*shapeSeqNum, PictureCrop(
+                                                 ptr_cropTop ? (int)(*ptr_cropTop) : 0,
+                                                 ptr_cropBottom ? (int)(*ptr_cropBottom) : 0,
+                                                 ptr_cropLeft ? (int)(*ptr_cropLeft) : 0,
+                                                 ptr_cropRight ? (int)(*ptr_cropRight) : 0));
+            }
           }
           unsigned *ptr_lineBackColor =
             getIfExists(foptValues.m_scalarValues, FIELDID_LINE_BACK_COLOR);
